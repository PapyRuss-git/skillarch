# Dunst Configuration for SkillArch + Hyprland

[global]
    ### Display ###
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 300)
    origin = top-right
    offset = (30, 20)
    notification_limit = 5
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    gap_size = 8
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#A7C080"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Text ###
    font = JetBrains Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = left
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_corner_radius = 6

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/google-chrome-stable
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 10
    ignore_dbusclose = false
    progress_bar = true
    progress_bar_horizontal_alignment = center
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 320
    progress_bar_max_width = 320
    progress_bar_corner_radius = 2

    ### Wayland ###
    force_xwayland = false
    
    ### mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#272E33"
    foreground = "#9DA9A0"
    highlight = "#495156"
    frame_color = "#495156"
    timeout = 6

[urgency_normal]
    background = "#2E383C"
    foreground = "#D3C6AA"
    highlight = "#83C092,#A7C080"
    frame_color = "#A7C080"
    timeout = 8

[urgency_critical]
    background = "#493B40"
    foreground = "#D3C6AA"
    highlight = "#E67E80"
    frame_color = "#E67E80"
    timeout = 0

# Application-specific rules
[SkillArch]
    appname = SkillArch*
    format = "<b>SkillArch</b>\n%b"
    urgency = normal

[Volume]
    summary = "Volume*"
    urgency = low
    format = "%s: %b"
    timeout = 2

[Brightness]
    summary = "Brightness*" 
    urgency = low
    format = "%s: %b"
    timeout = 2
