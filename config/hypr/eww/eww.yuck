; eww.yuck - SkillArch bar + "Activate Linux" watermark
; Everforest themed bar for Hyprland

; ═══════════════════════════════════════════════════════════════
; Variables
; ═══════════════════════════════════════════════════════════════

(deflisten workspaces :initial "[]"
  "~/.config/eww/scripts/workspaces.sh")

(defpoll clock :interval "1s"
  "date '+%H:%M'")

(defpoll clock-date :interval "60s"
  "date '+%a %d %b'")

(deflisten volume :initial '{"percent":0,"muted":"no","icon":"󰕾"}'
  "~/.config/eww/scripts/volume.sh")

(defpoll bluetooth :interval "5s"
  :initial '{"status":"off","icon":"󰂲","text":"","class":"off"}'
  "~/.config/eww/scripts/bluetooth.sh")

(defpoll vpn :interval "5s"
  :initial '{"status":"disconnected","icon":"󰦞","text":"OFF","class":"disconnected"}'
  "~/.config/eww/scripts/vpn.sh")

(defpoll network :interval "5s"
  :initial '{"status":"disconnected","ssid":"","signal":0,"icon":"󰤭"}'
  "~/.config/eww/scripts/network.sh")

(deflisten brightness :initial '{"percent":0,"icon":"󰃠","nightlight":""}'
  "~/.config/eww/scripts/brightness.sh")

(defpoll battery :interval "10s"
  :initial '{"percent":0,"status":"Unknown","icon":"󰁹","class":"none"}'
  "~/.config/eww/scripts/battery.sh")

(defpoll cpu :interval "2s"
  :initial '{"percent":0,"icon":"󰻠"}'
  "~/.config/eww/scripts/cpu.sh")

(defpoll ram :interval "2s"
  :initial '{"percent":0,"used":0,"total":0,"icon":"󰍛"}'
  "~/.config/eww/scripts/ram.sh")

; ═══════════════════════════════════════════════════════════════
; Widgets
; ═══════════════════════════════════════════════════════════════

; --- Workspaces (only show occupied/active) ---
(defwidget workspaces-widget []
  (box :class "workspaces" :orientation "h" :spacing 0
    (for ws in workspaces
      (button
        :class "ws ${ws.class}"
        :visible {ws.class != "inactive"}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        "${ws.id}"))))

; --- Clock ---
(defwidget clock-widget []
  (box :class "clock" :orientation "h" :spacing 6
    (label :text clock)
    (label :class "clock-date" :text clock-date)))

; --- Volume ---
(defwidget volume-widget []
  (eventbox
    :onclick "pavucontrol &"
    :onscroll "if [ '{}' = 'up' ]; then pactl set-sink-volume @DEFAULT_SINK@ +5%; else pactl set-sink-volume @DEFAULT_SINK@ -5%; fi"
    (label :class "module volume ${volume.muted == 'yes' ? 'muted' : ''}"
      :text "${volume.icon} ${volume.percent}%")))

; --- Bluetooth ---
(defwidget bluetooth-widget []
  (eventbox
    :onclick "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on) &"
    :onrightclick "XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth &"
    (label :class "module bluetooth ${bluetooth.class}"
      :text "${bluetooth.icon} ${bluetooth.text}"
      :limit-width 12)))

; --- VPN ---
(defwidget vpn-widget []
  (eventbox
    :onclick "~/.config/waybar/scripts/vpn-toggle.sh &"
    :onrightclick "nm-connection-editor &"
    (label :class "module vpn ${vpn.class}"
      :text "${vpn.icon} ${vpn.text}"
      :limit-width 10)))

; --- Network ---
(defwidget network-widget []
  (eventbox
    :onrightclick "XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi &"
    (label :class "module network ${network.status}"
      :text "${network.status == 'connected' ? '${network.icon} ${network.ssid}' : ' ${network.icon} '}"
      :limit-width 14)))

; --- Brightness ---
(defwidget brightness-widget []
  (eventbox
    :onclick "pkill -x hyprsunset || hyprsunset >/dev/null 2>&1 &"
    :onscroll "if [ '{}' = 'up' ]; then brightnessctl set +5%; else brightnessctl set 5%-; fi"
    (label :class "module brightness"
      :text "${brightness.icon} ${brightness.percent}%${brightness.nightlight != '' ? ' ${brightness.nightlight}' : ''}")))

; --- Battery ---
(defwidget battery-widget []
  (label :class "module battery ${battery.class}"
    :text "${battery.icon} ${battery.percent}%"
    :visible {battery.class != "none"}))

; --- CPU ---
(defwidget cpu-widget []
  (label :class "module cpu"
    :text "${cpu.icon} ${cpu.percent}%"))

; --- RAM ---
(defwidget ram-widget []
  (label :class "module ram"
    :text "${ram.icon} ${ram.percent}%"))

; ═══════════════════════════════════════════════════════════════
; Bar layout
; ═══════════════════════════════════════════════════════════════

(defwidget bar-left []
  (box :halign "start" :spacing 0 :space-evenly false
    (workspaces-widget)))

(defwidget bar-center []
  (box :halign "center" :spacing 0 :space-evenly false
    (clock-widget)))

(defwidget bar-right []
  (box :halign "end" :spacing 2 :space-evenly false
    (volume-widget)
    (bluetooth-widget)
    (vpn-widget)
    (network-widget)
    (brightness-widget)
    (battery-widget)
    (cpu-widget)
    (ram-widget)))

(defwidget bar-layout []
  (centerbox :orientation "h" :class "bar-inner"
    (bar-left)
    (bar-center)
    (bar-right)))

; ═══════════════════════════════════════════════════════════════
; Windows
; ═══════════════════════════════════════════════════════════════

(defwindow bar
  :monitor 0
  :stacking "fg"
  :exclusive true
  :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-layout))

; ═══════════════════════════════════════════════════════════════
; Activate Linux watermark (preserved from original)
; ═══════════════════════════════════════════════════════════════

(defwidget activate-linux []
  (box
    :class "activate-linux"
    :orientation "v"
    :halign "start"
    :valign "start"
    (label :xalign 0 :markup "<span font_size=\"large\">Activate Linux</span>")
    (label :xalign 0 :text "Go to Settings to activate Linux")))

; Window for monitor 0
(defwindow activate-linux-0
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 1
(defwindow activate-linux-1
  :monitor 1
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 2
(defwindow activate-linux-2
  :monitor 2
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 3
(defwindow activate-linux-3
  :monitor 3
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))
