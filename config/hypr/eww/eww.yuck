; eww.yuck - SkillArch bar + "Activate Linux" watermark
; Everforest themed bar for Hyprland

; ═══════════════════════════════════════════════════════════════
; Variables
; ═══════════════════════════════════════════════════════════════

(deflisten workspaces :initial "[]"
  "~/.config/eww/scripts/workspaces.sh")

(defpoll clock :interval "1s"
  "date '+%H:%M'")

(defpoll clock-date :interval "60s"
  "date '+%a %d %b'")

(deflisten volume :initial '{"percent":0,"muted":"no","icon":"󰕾"}'
  "~/.config/eww/scripts/volume.sh")

(defpoll bluetooth :interval "5s"
  :initial '{"status":"off","icon":"󰂲","text":"","class":"off"}'
  "~/.config/eww/scripts/bluetooth.sh")

(defpoll vpn :interval "5s"
  :initial '{"status":"disconnected","icon":"󰦞","text":"OFF","class":"disconnected"}'
  "~/.config/eww/scripts/vpn.sh")

(defpoll network :interval "5s"
  :initial '{"status":"disconnected","ssid":"","signal":0,"icon":"󰤭"}'
  "~/.config/eww/scripts/network.sh")

(deflisten brightness :initial '{"percent":0,"icon":"󰃠","nightlight":""}'
  "~/.config/eww/scripts/brightness.sh")

(defpoll battery :interval "10s"
  :initial '{"percent":0,"status":"Unknown","icon":"󰁹","class":"none"}'
  "~/.config/eww/scripts/battery.sh")

(defpoll cpu :interval "2s"
  :initial '{"percent":0,"icon":"󰻠"}'
  "~/.config/eww/scripts/cpu.sh")

(defpoll ram :interval "2s"
  :initial '{"percent":0,"used":0,"total":0,"icon":"󰍛"}'
  "~/.config/eww/scripts/ram.sh")

(defpoll temperature :interval "5s"
  :initial '{"temp":0,"icon":"󰔏","class":"normal"}'
  "~/.config/eww/scripts/temperature.sh")

(defpoll disk :interval "60s"
  :initial '{"percent":0,"used":"?","icon":"󰋊","class":"normal"}'
  "~/.config/eww/scripts/disk.sh")

(defpoll updates :interval "1800s"
  :initial '{"count":0,"icon":"󰏗","class":"none"}'
  "~/.config/eww/scripts/updates.sh")

(deflisten mic :initial '{"muted":false,"icon":"󰍬","class":""}'
  "~/.config/eww/scripts/mic.sh")

(deflisten wifi-list :initial "[]"
  "~/.config/eww/scripts/wifi-list.sh")

(deflisten bluetooth-devices :initial "[]"
  "~/.config/eww/scripts/bluetooth-devices.sh")

; ═══════════════════════════════════════════════════════════════
; Widgets
; ═══════════════════════════════════════════════════════════════

; --- Workspaces (filtered per monitor) ---
(defwidget workspaces-widget [monitor]
  (box :class "workspaces" :orientation "h" :spacing 0
    (for ws in workspaces
      (button
        :class "ws ${ws.class}"
        :visible {ws.monitor == monitor}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        "${ws.id}"))))

; --- Clock ---
(defwidget clock-widget []
  (box :class "clock" :orientation "h" :spacing 6
    (label :text clock)
    (label :class "clock-date" :text clock-date)))

; --- Volume ---
(defwidget volume-widget []
  (eventbox
    :onclick "pavucontrol &"
    :onscroll "if [ '{}' = 'up' ]; then pactl set-sink-volume @DEFAULT_SINK@ +5%; else pactl set-sink-volume @DEFAULT_SINK@ -5%; fi"
    (label :class "module volume ${volume.muted == 'yes' ? 'muted' : ''}"
      :text "${volume.icon} ${volume.percent}%")))

; --- Bluetooth ---
(defwidget bluetooth-widget []
  (eventbox
    :onclick "~/.config/eww/scripts/popup-toggle.sh bluetooth-popup"
    :onrightclick "XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth &"
    (label :class "module bluetooth ${bluetooth.class}"
      :text "${bluetooth.icon} ${bluetooth.text}"
      :limit-width 12)))

; --- VPN ---
(defwidget vpn-widget []
  (eventbox
    :onclick "~/.config/waybar/scripts/vpn-toggle.sh &"
    :onrightclick "nm-connection-editor &"
    (label :class "module vpn ${vpn.class}"
      :text "${vpn.icon} ${vpn.text}"
      :limit-width 18)))

; --- Network ---
(defwidget network-widget []
  (eventbox
    :onclick "~/.config/eww/scripts/popup-toggle.sh wifi-popup"
    :onrightclick "XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi &"
    (label :class "module network ${network.status}"
      :text "${network.status == 'connected' ? '${network.icon} ${network.ssid}' : ' ${network.icon} '}"
      :limit-width 14)))

; --- Brightness ---
(defwidget brightness-widget []
  (eventbox
    :onclick "pkill -x hyprsunset || hyprsunset >/dev/null 2>&1 &"
    :onscroll "if [ '{}' = 'up' ]; then brightnessctl set +5%; else brightnessctl set 5%-; fi"
    (label :class "module brightness"
      :text "${brightness.icon} ${brightness.percent}%${brightness.nightlight != '' ? ' ${brightness.nightlight}' : ''}")))

; --- Battery ---
(defwidget battery-widget []
  (label :class "module battery ${battery.class}"
    :text "${battery.icon} ${battery.percent}%"
    :visible {battery.class != "none"}))

; --- CPU ---
(defwidget cpu-widget []
  (label :class "module cpu"
    :text "${cpu.icon} ${cpu.percent}%"))

; --- Temperature ---
(defwidget temperature-widget []
  (label :class "module temperature ${temperature.class}"
    :text "${temperature.icon} ${temperature.temp}°C"))

; --- RAM ---
(defwidget ram-widget []
  (label :class "module ram"
    :text "${ram.icon} ${ram.percent}%"))

; --- Disk ---
(defwidget disk-widget []
  (label :class "module disk ${disk.class}"
    :text "${disk.icon} ${disk.percent}%"))

; --- Updates ---
(defwidget updates-widget []
  (eventbox
    :onclick "kitty --title 'System Update' sh -c 'yay -Syu; echo Done; read' &"
    (label :class "module updates ${updates.class}"
      :text "${updates.icon} ${updates.count}"
      :visible {updates.count > 0})))

; --- Microphone ---
(defwidget mic-widget []
  (eventbox
    :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    (label :class "module mic ${mic.class}"
      :text "${mic.icon}")))

; ═══════════════════════════════════════════════════════════════
; Popup widgets
; ═══════════════════════════════════════════════════════════════

; --- WiFi popup ---
(defwidget wifi-popup-widget []
  (box :class "popup-container" :orientation "v" :spacing 6 :space-evenly false
    (box :class "popup-header" :orientation "h" :space-evenly false
      (label :text "󰤨  WiFi" :hexpand true :halign "start")
      (button :class "popup-toggle ${network.status == 'connected' || wifi-list != '[]' ? 'on' : 'off'}"
        :onclick "nmcli radio wifi $(nmcli radio wifi | grep -q enabled && echo off || echo on) &"
        {network.status == "connected" || wifi-list != "[]" ? "ON" : "OFF"}))
    (scroll :vscroll true :height 300
      (box :class "popup-list" :orientation "v" :spacing 4
        (for net in wifi-list
          (button :class "popup-item ${net.connected ? 'connected' : 'disconnected'}"
            :onclick "~/.config/eww/scripts/wifi-connect.sh '${net.ssid}' &"
            (box :orientation "h" :spacing 8 :space-evenly false
              (label :class "popup-item-icon" :text {net.icon} :width 20)
              (box :orientation "v" :space-evenly false :hexpand true
                (label :class "popup-item-name" :text {net.ssid} :halign "start" :limit-width 24)
                (label :class "popup-item-detail" :halign "start"
                  :text "${net.signal}%${net.security != '' && net.security != '--' ? '  󰌾 ' : '  '}${net.security != '--' ? net.security : 'Open'}"))
              (label :class "popup-item-badge" :text {net.connected ? "󰄬" : (net.known ? "󰁯" : "")}
                :halign "end"))))))))

; --- Bluetooth popup ---
(defwidget bluetooth-popup-widget []
  (box :class "popup-container" :orientation "v" :spacing 6 :space-evenly false
    (box :class "popup-header" :orientation "h" :space-evenly false
      (label :text "󰂯  Bluetooth" :hexpand true :halign "start")
      (button :class "popup-toggle ${bluetooth.status != 'off' ? 'on' : 'off'}"
        :onclick "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on) &"
        {bluetooth.status != "off" ? "ON" : "OFF"}))
    (scroll :vscroll true :height 240
      (box :class "popup-list" :orientation "v" :spacing 4
        (for dev in bluetooth-devices
          (button :class "popup-item ${dev.connected ? 'connected' : 'disconnected'}"
            :onclick "~/.config/eww/scripts/bluetooth-toggle-device.sh '${dev.mac}' &"
            (box :orientation "h" :spacing 8 :space-evenly false
              (label :class "popup-item-icon" :text {dev.icon} :width 20)
              (box :orientation "v" :space-evenly false :hexpand true
                (label :class "popup-item-name" :text {dev.name} :halign "start" :limit-width 20)
                (label :class "popup-item-detail" :halign "start"
                  :text "${dev.connected ? 'Connected' : 'Disconnected'}${dev.battery != '' ? '  󰁹 ${dev.battery}%' : ''}"))
              (label :class "popup-item-badge ${dev.connected ? 'active' : ''}"
                :text {dev.connected ? "󰄬" : ""}
                :halign "end"))))))))

; ═══════════════════════════════════════════════════════════════
; Bar layout
; ═══════════════════════════════════════════════════════════════

; --- Full bar layout (parameterized by monitor) ---
(defwidget bar-layout [monitor]
  (centerbox :orientation "h" :class "bar-inner"
    (box :halign "start" :spacing 0 :space-evenly false
      (label :class "clock" :text clock))
    (box :halign "center" :spacing 0 :space-evenly false
      (workspaces-widget :monitor monitor))
    (box :halign "end" :spacing 2 :space-evenly false
      (volume-widget)
      (mic-widget)
      (bluetooth-widget)
      (vpn-widget)
      (network-widget)
      (brightness-widget)
      (battery-widget)
      (box :class "system-group" :orientation "h" :spacing 2 :space-evenly false
        (cpu-widget)
        (temperature-widget)
        (ram-widget)
        (disk-widget))
      (updates-widget)
      (label :class "clock clock-date" :text clock-date))))

; --- Minimal bar for vertical monitors (parameterized by monitor) ---
(defwidget bar-minimal-layout [monitor]
  (centerbox :orientation "h" :class "bar-inner"
    (box :halign "start" :spacing 0 :space-evenly false
      (label :class "clock" :text clock))
    (box :halign "center" :spacing 0 :space-evenly false
      (workspaces-widget :monitor monitor))
    (box :halign "end" :spacing 0 :space-evenly false
      (label :class "clock clock-date" :text clock-date))))

; ═══════════════════════════════════════════════════════════════
; Windows (one per monitor, full and minimal variants)
; ═══════════════════════════════════════════════════════════════

(defwindow bar-0
  :monitor 0 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-layout :monitor 0))

(defwindow bar-1
  :monitor 1 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-layout :monitor 1))

(defwindow bar-2
  :monitor 2 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-layout :monitor 2))

(defwindow bar-3
  :monitor 3 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-layout :monitor 3))

(defwindow bar-minimal-0
  :monitor 0 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-minimal-layout :monitor 0))

(defwindow bar-minimal-1
  :monitor 1 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-minimal-layout :monitor 1))

(defwindow bar-minimal-2
  :monitor 2 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-minimal-layout :monitor 2))

(defwindow bar-minimal-3
  :monitor 3 :stacking "fg" :exclusive true :focusable false
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  (bar-minimal-layout :monitor 3))

; ═══════════════════════════════════════════════════════════════
; Activate Linux watermark (preserved from original)
; ═══════════════════════════════════════════════════════════════

(defwidget activate-linux []
  (box
    :class "activate-linux"
    :orientation "v"
    :halign "start"
    :valign "start"
    (label :xalign 0 :markup "<span font_size=\"large\">Activate Linux</span>")
    (label :xalign 0 :text "Go to Settings to activate Linux")))

; Window for monitor 0
(defwindow activate-linux-0
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 1
(defwindow activate-linux-1
  :monitor 1
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 2
(defwindow activate-linux-2
  :monitor 2
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; Window for monitor 3
(defwindow activate-linux-3
  :monitor 3
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "16px" :y "48px" :width "280px" :anchor "bottom right")
  (activate-linux))

; ═══════════════════════════════════════════════════════════════
; Popup closer (invisible fullscreen click-catcher behind popups)
; ═══════════════════════════════════════════════════════════════

(defwindow closer-0
  :monitor 0 :stacking "fg" :exclusive false :focusable false
  :geometry (geometry :width "100%" :height "100%")
  (button :class "closer" :onclick "~/.config/eww/scripts/popup-close-all.sh"))

(defwindow closer-1
  :monitor 1 :stacking "fg" :exclusive false :focusable false
  :geometry (geometry :width "100%" :height "100%")
  (button :class "closer" :onclick "~/.config/eww/scripts/popup-close-all.sh"))

(defwindow closer-2
  :monitor 2 :stacking "fg" :exclusive false :focusable false
  :geometry (geometry :width "100%" :height "100%")
  (button :class "closer" :onclick "~/.config/eww/scripts/popup-close-all.sh"))

(defwindow closer-3
  :monitor 3 :stacking "fg" :exclusive false :focusable false
  :geometry (geometry :width "100%" :height "100%")
  (button :class "closer" :onclick "~/.config/eww/scripts/popup-close-all.sh"))

; ═══════════════════════════════════════════════════════════════
; Popup windows (overlay = above closer, below nothing)
; ═══════════════════════════════════════════════════════════════

(defwindow wifi-popup-0
  :monitor 0 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "300px" :height "350px" :anchor "top right")
  (wifi-popup-widget))

(defwindow wifi-popup-1
  :monitor 1 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "300px" :height "350px" :anchor "top right")
  (wifi-popup-widget))

(defwindow wifi-popup-2
  :monitor 2 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "300px" :height "350px" :anchor "top right")
  (wifi-popup-widget))

(defwindow wifi-popup-3
  :monitor 3 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "300px" :height "350px" :anchor "top right")
  (wifi-popup-widget))

(defwindow bluetooth-popup-0
  :monitor 0 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "280px" :height "300px" :anchor "top right")
  (bluetooth-popup-widget))

(defwindow bluetooth-popup-1
  :monitor 1 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "280px" :height "300px" :anchor "top right")
  (bluetooth-popup-widget))

(defwindow bluetooth-popup-2
  :monitor 2 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "280px" :height "300px" :anchor "top right")
  (bluetooth-popup-widget))

(defwindow bluetooth-popup-3
  :monitor 3 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "0px" :y "36px" :width "280px" :height "300px" :anchor "top right")
  (bluetooth-popup-widget))
