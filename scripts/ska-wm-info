#!/usr/bin/env bash
# SkillArch Window Manager Information Helper
# Displays current WM, session type, and useful info

set -euo pipefail

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Icons
INFO_ICON="ℹ️"
CHECK_ICON="✅"
CROSS_ICON="❌"
DESKTOP_ICON="🖥️"
WAYLAND_ICON="🌊"
X11_ICON="🪟"

echo -e "${BOLD}═══════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}  SkillArch Window Manager Information${NC}"
echo -e "${BOLD}═══════════════════════════════════════════════════════════${NC}"
echo ""

# Detect session type
SESSION_TYPE="${XDG_SESSION_TYPE:-unknown}"
DESKTOP="${XDG_CURRENT_DESKTOP:-unknown}"

if [[ "$SESSION_TYPE" == "wayland" ]]; then
    echo -e "${WAYLAND_ICON}  ${BLUE}Session Type:${NC} ${BOLD}Wayland${NC}"
elif [[ "$SESSION_TYPE" == "x11" ]]; then
    echo -e "${X11_ICON}  ${BLUE}Session Type:${NC} ${BOLD}X11${NC}"
else
    echo -e "${DESKTOP_ICON}  ${BLUE}Session Type:${NC} ${YELLOW}${SESSION_TYPE}${NC}"
fi

echo -e "${DESKTOP_ICON}  ${BLUE}Desktop:${NC} ${BOLD}${DESKTOP}${NC}"
echo ""

# Detect Window Manager
if pgrep -x "Hyprland" &>/dev/null; then
    echo -e "${CHECK_ICON}  ${GREEN}Window Manager:${NC} ${BOLD}Hyprland${NC} (running)"

    if command -v hyprctl &>/dev/null; then
        HYPR_VERSION=$(hyprctl version | head -1 | awk '{print $2}')
        echo -e "${INFO_ICON}  ${CYAN}Version:${NC} ${HYPR_VERSION}"

        # Check which config is loaded
        if hyprctl monitors &>/dev/null 2>&1; then
            MONITORS=$(hyprctl monitors -j | jq -r 'length')
            echo -e "${INFO_ICON}  ${CYAN}Monitors:${NC} ${MONITORS}"

            # Check if animations are enabled
            ANIM_ENABLED=$(hyprctl getoption animations:enabled -j | jq -r '.int')
            if [[ "$ANIM_ENABLED" == "1" ]]; then
                echo -e "${INFO_ICON}  ${CYAN}Animations:${NC} ${GREEN}Enabled${NC} (Desktop mode)"
            else
                echo -e "${INFO_ICON}  ${CYAN}Animations:${NC} ${YELLOW}Disabled${NC} (VM mode)"
            fi

            # Check blur
            BLUR_ENABLED=$(hyprctl getoption decoration:blur:enabled -j | jq -r '.int')
            if [[ "$BLUR_ENABLED" == "1" ]]; then
                echo -e "${INFO_ICON}  ${CYAN}Blur:${NC} ${GREEN}Enabled${NC}"
            else
                echo -e "${INFO_ICON}  ${CYAN}Blur:${NC} ${YELLOW}Disabled${NC}"
            fi
        fi

        # Config file location (Lua since Hyprland 0.55; fall back to legacy .conf)
        HYPR_CONFIG="$HOME/.config/hypr/hyprland.lua"
        [[ -e "$HYPR_CONFIG" ]] || HYPR_CONFIG="$HOME/.config/hypr/hyprland.conf"
        if [[ -L "$HYPR_CONFIG" ]]; then
            CONFIG_TARGET=$(readlink -f "$HYPR_CONFIG")
            echo -e "${INFO_ICON}  ${CYAN}Config:${NC} $(basename $CONFIG_TARGET)"
        fi
    fi

elif pgrep -x "i3" &>/dev/null; then
    echo -e "${CHECK_ICON}  ${GREEN}Window Manager:${NC} ${BOLD}i3-gaps${NC} (running)"

    if command -v i3 &>/dev/null; then
        I3_VERSION=$(i3 --version | head -1 | awk '{print $3}')
        echo -e "${INFO_ICON}  ${CYAN}Version:${NC} ${I3_VERSION}"
    fi

    # Check if picom is running
    if pgrep -x "picom" &>/dev/null; then
        echo -e "${INFO_ICON}  ${CYAN}Compositor:${NC} ${GREEN}Picom (running)${NC}"
    else
        echo -e "${INFO_ICON}  ${CYAN}Compositor:${NC} ${YELLOW}Picom (not running)${NC}"
    fi

    # Check polybar
    if pgrep -x "polybar" &>/dev/null; then
        echo -e "${INFO_ICON}  ${CYAN}Status Bar:${NC} ${GREEN}Polybar (running)${NC}"
    else
        echo -e "${INFO_ICON}  ${CYAN}Status Bar:${NC} ${YELLOW}Polybar (not running)${NC}"
    fi

    # Config file location
    I3_CONFIG="$HOME/.config/i3/config"
    if [[ -L "$I3_CONFIG" ]]; then
        echo -e "${INFO_ICON}  ${CYAN}Config:${NC} Symlinked to SkillArch"
    fi

else
    echo -e "${CROSS_ICON}  ${RED}Window Manager:${NC} ${BOLD}Not detected${NC}"
    echo -e "${INFO_ICON}  ${YELLOW}No i3 or Hyprland process found${NC}"
fi

echo ""

# Display clipboard tool
if [[ "$SESSION_TYPE" == "wayland" ]]; then
    if command -v wl-copy &>/dev/null; then
        echo -e "${CHECK_ICON}  ${CYAN}Clipboard:${NC} ${GREEN}wl-clipboard${NC} (wl-copy/wl-paste)"
    else
        echo -e "${CROSS_ICON}  ${CYAN}Clipboard:${NC} ${RED}wl-clipboard not installed${NC}"
    fi
elif [[ "$SESSION_TYPE" == "x11" ]]; then
    if command -v xclip &>/dev/null; then
        echo -e "${CHECK_ICON}  ${CYAN}Clipboard:${NC} ${GREEN}xclip${NC}"
    else
        echo -e "${CROSS_ICON}  ${CYAN}Clipboard:${NC} ${RED}xclip not installed${NC}"
    fi
fi

# Display screenshot tool
if [[ "$SESSION_TYPE" == "wayland" ]]; then
    if command -v grim &>/dev/null && command -v slurp &>/dev/null; then
        echo -e "${CHECK_ICON}  ${CYAN}Screenshots:${NC} ${GREEN}grim + slurp${NC}"
    else
        echo -e "${CROSS_ICON}  ${CYAN}Screenshots:${NC} ${RED}grim/slurp not installed${NC}"
    fi
elif [[ "$SESSION_TYPE" == "x11" ]]; then
    if command -v flameshot &>/dev/null; then
        echo -e "${CHECK_ICON}  ${CYAN}Screenshots:${NC} ${GREEN}flameshot${NC}"
    else
        echo -e "${CROSS_ICON}  ${CYAN}Screenshots:${NC} ${RED}flameshot not installed${NC}"
    fi
fi

echo ""
echo -e "${BOLD}═══════════════════════════════════════════════════════════${NC}"
echo -e "${INFO_ICON}  ${CYAN}Tip:${NC} Use ${BOLD}ska-help-bindings${NC} to see keybindings"
echo -e "${BOLD}═══════════════════════════════════════════════════════════${NC}"
