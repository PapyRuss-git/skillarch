# Use one of the following instead:
#   - Dockerfile-full-i3       (i3 + X11)
#   - Dockerfile-full-hyprland (Hyprland + Wayland)

FROM alpine:3.19 AS deprecated
RUN echo "ERROR: Dockerfile-full is deprecated." && \
    echo "Use Dockerfile-full-i3 or Dockerfile-full-hyprland instead." && \
    exit 1
